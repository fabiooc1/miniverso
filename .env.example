DATABASE_URL="postgres://postgres:<senha>@db.<projeto>.supabase.co:6543/postgres"
DIRECT_URL="postgres://postgres:<senha>@db.<projeto>.supabase.co:5432/postgres"

# Superadmin inicial, criado por `pnpm db:seed` (ignorado se vazio)
SUPERADMIN_NAME=""
SUPERADMIN_EMAIL=""
SUPERADMIN_PASSWORD=""

# Better Auth
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# Armazenamento de imagens: "local" (pasta uploads/) ou "supabase"
STORAGE_PROVIDER="supabase"
# Opcional: sobrescreve a URL pública das imagens (por padrão é derivada do provedor)
NEXT_PUBLIC_FILES_BASE_URL=""
# Supabase Storage (a service role key é secreta: nunca use prefixo NEXT_PUBLIC_)
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="imagens"
